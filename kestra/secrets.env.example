# Template for kestra/secrets.env (the REAL file is gitignored — never commit secrets).
# Setup:
#     cp kestra/secrets.env.example kestra/secrets.env   # then fill in real values
# Load before triggering flows:
#     set -a; . kestra/secrets.env; set +a
# Trigger example:
#     curl -u "$KESTRA_USER:$KESTRA_PASS" -X POST \
#       "$KESTRA_URL/api/v1/$KESTRA_TENANT/executions/prod.nci60/build_nci60_cell_xref" \
#       -F 'git_branch=feature/NCI60'
KESTRA_URL=https://pipeline.comp.mocomakers.com
KESTRA_TENANT=main
KESTRA_USER=you@example.com
KESTRA_PASS=
