# Kestra secrets template (DO NOT commit real values)
#
# In Kestra UI: Settings → Secrets, or kestra.yml / env SECRET_* variables.
# Names must match what flows reference: {{ secret('PG_HOST') }}, etc.

# --- PostgreSQL (remote warehouse) ---
PG_HOST: dmvpetridishdatastore.dev
PG_PORT: "5432"
PG_USER: comp_bio_u2
PG_DATABASE: data_warehouse
PG_PASSWORD: "<your-password>"
# Optional; omit or set prefer/require if server needs TLS
PG_SSLMODE: prefer

# --- Google Drive (public Datasets folder) ---
# Default matches https://drive.google.com/drive/folders/1e0_UQzU-LksJxMEN5zJRikL0QbsWrJej
GDRIVE_DATASETS_FOLDER_ID: "1e0_UQzU-LksJxMEN5zJRikL0QbsWrJej"
# Optional: direct link to NCI subfolder only (smaller download)
GDRIVE_NCI_FOLDER_ID: ""

# --- Git sync webhook (prod.sync namespace) ---
# Webhook URL: .../webhook/prod.sync/sync_git_flows/<WEBHOOK_KEY>
WEBHOOK_KEY: "<rotate-from-old-GoKeyGo432L>"
